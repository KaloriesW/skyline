# Skyline app settings. Copy to `.env` (next to server.py) and fill in what you need.
# `.env` is ignored by git; never put real values in this example file.
# Real environment variables win over this file. Everything is optional.

# ---- server (read by run.sh) ----
# HOST=127.0.0.1              # 0.0.0.0 to listen on every interface
# PORT=8765

# ---- next-day PM2.5 / PM10: GET /api/predict?lat=&lon= ----
# Works with nothing set: one model per city in model/models/ (plain numbers, no scikit-learn needed),
# live inputs from Open-Meteo (no key).
# PM25_CACHE_SECONDS=1800     # how long a city's answer is reused
# PM25_MAX_KM=25              # a point farther than this from every city centre gets 404 (no model answer)
# PM25_MODEL_URL=             # fallback only: the team app's /api/predict, used for Taichung when
#                             # model/models/taichung.json is missing

# ---- built-in Ask AI: POST /api/ask ----
# Without a key the "Skyline (no setup)" provider shows as unavailable.
# OPENROUTER_API_KEY=
# ASK_MODEL=google/gemini-2.5-flash-lite
# ASK_BUDGET_USD=5            # hard cap on total spend
# ASK_SPEND_FILE=             # default: ask_spend.json next to server.py; delete it to reset the total
# ASK_RESERVE_USD=0.01        # held per request while it runs
# ASK_RATE_PER_MIN=5          # questions per visitor IP per minute
# ASK_RATE_PER_DAY=40         # questions per visitor IP per day
# ASK_GLOBAL_PER_MIN=30       # questions per minute from everyone together
# ASK_MAX_CONCURRENT=4        # answers streaming at once
# ASK_MAX_MESSAGES=12
# ASK_MAX_INPUT_CHARS=6000
# ASK_MAX_CONTEXT_CHARS=4000
# ASK_MAX_TOKENS=600          # never more than 2000
# ASK_MAX_SECONDS=60
# ASK_TRUST_PROXY_HEADERS=1   # take the visitor IP from CF-Connecting-IP / X-Forwarded-For; set 0 when
#                             # the server is reached directly (otherwise visitors can fake their IP)

# ---- typhoon: GET /api/typhoon ----
# With nothing set, the app reads CWA's public AWS open-data mirror (no key).
# CWA_API_KEY=                # CWA open data member key: use the member API instead of the mirror
# CWA_TYPHOON_URL=            # fetch the typhoon file from this URL (wins over the key); empty = feed off
# TYPHOON_CACHE_SECONDS=600
# TYPHOON_STALE_HOURS=12      # a storm counts as active while its newest fix is at most this old

# ---- landslide: GET /api/landslide ----
# LANDSLIDE_API_URL=          # called as GET <url>?lat=&lon=; 503 until set

# ---- MCP endpoint: POST /mcp ----
# MCP_ALLOWED_HOSTS=veritas.premiersalesri.com   # public host names /mcp answers on (localhost always works); * = any
# MCP_ALLOWED_ORIGINS=        # browser origins allowed to call /mcp; default https://<each allowed host>
# SKYLINE_API=https://veritas.premiersalesri.com # where the MCP tool get_pm25_forecast_taichung finds the team app
